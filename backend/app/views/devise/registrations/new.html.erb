<div class="m-3">
    <%= render 'shared/form_errors', object: @user%>
    <%= render 'shared/form_exited', object: @user%>
</div>

<h1 class="text-uppercase title-devise mb-5 mt-5"><%= t('sign_up') %></h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <div class="text-center">

    <!-- Name input -->
    <%= f.text_field :name,
      placeholder: t('name'),
      required: true,
      autofocus: true,
      autocomplete: "given-name",
      class: "login-input"
    %>

    <!-- Lastname input -->
    <%= f.text_field :last_name,
      placeholder: t('last_name'),
      required: true,
      autofocus: true,
      autocomplete: "family-name",
      class: "login-input"
    %>
    
    <!-- City input -->
    <%= f.text_field :city,
      placeholder: t('city'),
      required: true,
      autofocus: true,
      autocomplete: "address-level2",
      class: "login-input"
    %>

    <!-- Address input -->
    <%= f.text_field :address,
      placeholder: t('address'),
      required: true,
      autofocus: true,
      autocomplete: "address-level2",
      class: "login-input"
    %>

    <!-- Phone input -->
    <%= f.telephone_field :phone,
      placeholder: t('phone'),
      required: true,
      autofocus: true,
      autocomplete: "tel",
      class: "login-input"
    %>

    <!-- Email input -->
    <%= f.email_field :email,
      placeholder: t('email'),
      required: true,
      autofocus: true,
      autocomplete: "email",
      class: "login-input"
    %>
    <!-- Password input with toggle -->
    <% placeholder_text = if @minimum_password_length
      "#{t('password')} (#{@minimum_password_length} #{t('message_minium')})"
    else
      t('password')
    end %>

    <%= f.password_field :password,
      placeholder: placeholder_text,
      required: true,
      autocomplete: "new-password",
      class: "login-input pr-5",
      id: "password-field"
    %>
    
    <%= f.password_field :password_confirmation,
      placeholder: t('confirm_password'),
      required: true,
      autocomplete: "new-password",
      class: "login-input pr-5"
    %>

    <%= f.submit t('sign_up'), class: "text-uppercase login-button", id: "refresh-button" %>
    
    <div class="mt-3">
      <%= render "devise/shared/links" %>
    </div>
  </div>
<% end %>

<!-- Divider -->
<div style="display: flex; align-items: center; margin: 20px 0;">
  <div style="flex: 1; height: 1px; background-color: #dadce0;"></div>
  <span style="padding: 0 16px; color: #5f6368; font-size: 14px;">o</span>
  <div style="flex: 1; height: 1px; background-color: #dadce0;"></div>
</div>

<!-- Google OAuth Button -->
<div class="text-center">
  <%= form_with url: user_google_oauth2_omniauth_authorize_path, method: :post, local: true, data: { turbo: false } do %>
    <%= button_tag type: 'submit', class: "google-login-button" do %>
      <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        <path fill="none" d="M0 0h48v48H0z"/>
      </svg>
      <span>Continuar con Google</span>
    <% end %>
  <% end %>
</div>


<script>
  document.getElementById('refresh-button').addEventListener('click', function(e) {
    setTimeout(() => {
      // Verifica si existen errores de Devise renderizados para recargar la página
      const errors = document.querySelectorAll(".alert.alert-danger");
      if (errors.length > 0) {
        location.reload();
      }
    }, 2000);
  });
</script>
