<h1 class="text-center text-primary mb-4">
  <%= t('most_popular.title', default: 'Más populares') %>
</h1>

<% if @products.present? %>
  <div class="container py-4">
    <div class="row justify-content-center">
      <% @products.each do |product| %>
        <div class="col-6 col-md-4 col-lg-3 mb-4">
          <div class="card h-100">
            <%= link_to category_product_path(product.category, product) do %>
              <% if product.image.attached? %>
                <%= image_tag product.image, class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
              <% else %>
                <%= image_tag "placeholder.svg", class: "card-img-top", style: "height: 200px; object-fit: cover;" %>
              <% end %>
            <% end %>
            <div class="card-body text-center">
              <h6 class="card-title"><%= product.name %></h6>
              <p class="fw-bold text-success mb-2">
                <%= number_to_currency(product.price) %>
              </p>
              <%= link_to t("show_more"), category_product_path(product.category, product),
                  class: "btn btn-outline-primary btn-sm" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <p class="text-center text-muted">
    <%= t('no_products', default: 'No hay productos disponibles.') %>
  </p>
<% end %>
