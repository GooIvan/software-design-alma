<%# app/views/orders/payment.html.erb %>
<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css", crossorigin: "anonymous" %>
<%= stylesheet_link_tag "pay", media: "all" %>

<div class="container py-5">
  <div class="text-center mb-4">
    <h2 class="mt-3">Paga tu orden con tarjeta</h2>
    <p class="text-muted">Transacción segura en entorno de pruebas</p>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-6">
      <%= form_with url: pay_with_card_order_path(@order), method: :post, local: true do %>
        <div class="card shadow p-4">
          <h5 class="mb-3">Datos de la tarjeta</h5>

          <div class="mb-3">
            <label class="form-label">Número de tarjeta</label>
            <%= text_field_tag :card_number, nil, class: "form-control text-muted", placeholder: "4000 1234 5678 9010", required: true %>

            <div class="error-message">Este campo es obligatorio</div>
            <div class="d-flex justify-content-end mt-1">
              <%= image_tag "card_brands.png", alt: "Visa y MasterCard", style: "height: auto; width: 80px;" %>
            </div>
          </div>

          <div class="row">
            <div class="col">
              <label>Mes</label>
              <%= number_field_tag :expiration_month, nil, class: "form-control text-muted", placeholder: "MM", min: 1, max: 12, required: true %>
              <div class="error-message">Este campo es obligatorio</div>
            </div>
            <div class="col">
              <label>Año</label>
              <%= number_field_tag :expiration_year, nil, class: "form-control text-muted", placeholder: "YYYY", min: 2024, required: true %>
              <div class="error-message">Este campo es obligatorio</div>
            </div>
          </div>

          <div class="mt-3 mb-3">
            <label>Código CVV</label>
            <%= text_field_tag :cvv, nil, class: "form-control text-muted", placeholder: "123", required: true %>
            <div class="error-message">Este campo es obligatorio</div>
          </div>

          <div class="mb-3">
            <label>Nombre en la tarjeta</label>
            <%= text_field_tag :card_name, nil, class: "form-control text-muted", placeholder: "Nombre completo", required: true %>
            <div class="error-message">Este campo es obligatorio</div>
          </div>

          <%= hidden_field_tag :expiration, "", id: "expiration_hidden" %>

          <button type="submit" class="btn-payu w-100 mt-3" id="pay-button">
            <div class="spinner" id="spinner" role="status" aria-hidden="true" ></div>
            <span id="btn-text">💳 Pagar ahora<span>
          </button>

          <!-- Logo PayU debajo del botón -->
          <div class="text-center mt-3">
            <%= image_tag "payu_secure.png", alt: "Paga seguro con PayU", style: "height: 36px;" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-md-4 mt-4 mt-md-0">
      <div class="card border-info shadow p-3">
        <h5 class="mb-3 text-center">Resumen de la orden</h5>
        <p><strong>ID:</strong> <%= @order.id %></p>
        <p><strong>Total:</strong> <%= number_to_currency(@order.total, unit: "$", separator: ",", delimiter: ".") %></p>
        <ul class="list-group mt-3">
          <% @order.order_items.each do |item| %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <%= item.product.name %>
              <span class="badge bg-secondary">x<%= item.quantity %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>

<%= javascript_tag do %>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.querySelector("form");

    if (!form) return;

    form.addEventListener("submit", function (e) {
      const requiredFields = form.querySelectorAll("[required]");
      let isValid = true;

      requiredFields.forEach(field => {
        const wrapper = field.closest(".mb-3") || field.closest(".col");
        const error = wrapper.querySelector(".error-message");

        if (!field.value.trim()) {
          field.classList.add("input-error");
          if (error) error.classList.add("show");
          isValid = false;
        } else {
          field.classList.remove("input-error");
          if (error) error.classList.remove("show");
        }
      });

      if (!isValid) {
        e.preventDefault(); // No se envía el formulario
        return;
      }

      // Combinar fecha
      const year = form.querySelector("[name='expiration_year']").value;
      const month = form.querySelector("[name='expiration_month']").value.padStart(2, '0');
      form.querySelector("#expiration_hidden").value = `${year}/${month}`;

      // Spinner
      const spinner = document.querySelector("#spinner");
      const buttonText = document.querySelector("#btn-text");
      if (spinner && buttonText) {
        spinner.style.display = "inline-block";
        buttonText.textContent = "Procesando transacción...";
      }
    });
  });
<% end %>






