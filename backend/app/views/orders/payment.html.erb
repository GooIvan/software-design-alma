<%# app/views/orders/payment.html.erb %>
<%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css", crossorigin: "anonymous" %>
<%= stylesheet_link_tag "pay", media: "all" %>

<% subtotal = @order.total.to_f %> <!-- Número puro -->
<% discount = 0 %><br> <!-- Número puro -->

<div class="container py-5">
  <div class="text-center mb-4">
    <h2 class="mt-3 fw-bold">Paga tu orden con tarjeta</h2>
    <p class="text-muted">Tus datos están seguros y encriptados</p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-6">
      <%= form_with url: pay_with_card_order_path(@order), method: :post, local: true, scope: nil do %>
        <div class="card p-4 shadow-sm">
          <h5 class="mb-4 fw-semibold">Información de pago</h5>
          <div class="mb-3">
            <label for="card_number" class="form-label">Número de tarjeta</label>
            <%= text_field_tag :card_number, nil, class: "form-control", id: "card_number", placeholder: "4111 1111 1111 1111", required: true %>
            <div class="invalid-feedback">Este campo es obligatorio</div>
            <div class="d-flex justify-content-end mt-2">
              <%= image_tag "card_brands.png", alt: "Visa y MasterCard", style: "width: 80px;" %>
            </div>
          </div>

        <div class="mb-3">
          <label for="expiration_select" class="form-label">Fecha de expiración</label>
          <div class="d-flex gap-2">
            <%= select_tag :expiration_month,
              options_for_select((1..12).map { |m| [sprintf("%02d", m), sprintf("%02d", m)] }),
              prompt: "MM", class: "form-select", id: "expiration_month", required: true %>

            <%= select_tag :expiration_year,
              options_for_select((Date.today.year..(Date.today.year + 10)).map { |y| [y, y] }),
              prompt: "YYYY", class: "form-select", id: "expiration_year", required: true %>
          </div>
          <div class="invalid-feedback">Selecciona mes y año</div>
        </div>

          <div class="mb-3">
            <label for="cvv" class="form-label">Código CVV</label>
            <%= text_field_tag :cvv, nil, class: "form-control", id: "cvv", placeholder: "123", required: true %>
            <div class="invalid-feedback">Este campo es obligatorio</div>
          </div>

          <div class="mb-3">
            <label for="card_name" class="form-label">Nombre en la tarjeta</label>
            <%= text_field_tag :card_name, nil, class: "form-control", id: "card_name", placeholder: "Nombre completo", required: true %>
            <div class="invalid-feedback">Este campo es obligatorio</div>
          </div>

          <%= hidden_field_tag :expiration, "", id: "expiration_hidden" %>

          <button type="submit" class="btn btn-success w-100 mt-3" id="pay-button">
            <span class="spinner-border spinner-border-sm d-none" id="spinner" role="status" aria-hidden="true"></span>
            <span id="btn-text">Pagar ahora</span>
          </button>

          <div class="text-center mt-3">
            <%= image_tag "payu_secure.png", alt: "Paga seguro con PayU", style: "height: 36px;" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
      <div class="card shadow-sm p-3">
        <h5 class="mb-3 text-center fw-bold">
          <%= t("orders.summary", default: "Resumen de la orden") %>
        </h5>

        <!-- Productos -->
        <% @order.order_items.each do |item| %>
          <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
            <!-- Imagen del producto -->
            <% if item.product.image.attached? %>
              <%= image_tag url_for(item.product.image), class: "rounded me-3", style: "width: 65px; height: 65px; object-fit: cover;" %>
            <% else %>
              <div class="rounded bg-secondary me-3" style="width: 65px; height: 65px;"></div>
            <% end %>

            <!-- Información -->
            <div class="flex-grow-1">
              <div class="fw-semibold fs-6"><%= item.product.name %></div>
              <div class="text-muted small">#<%= item.product.id %></div>
              <% if item.size.present? %>
                <div class="small text-muted">Talla: <%= item.size %></div>
              <% end %>
            </div>

            <!-- Cantidad -->
            <div class="text-end small fw-bold ms-2 d-none d-md-block">
              x<%= item.quantity %>
            </div>

            <!-- Subtotal -->
            <div class="fw-bold ms-3 text-nowrap d-none d-md-block">
              <%= number_to_currency(item.price * item.quantity, unit: "$", precision: 0, delimiter: ".") %>
            </div>
          </div>
        <% end %>

        <!-- Resumen -->
        <div class="border-0 mt-3">
          <ul class="list-unstyled">
            <li class="d-flex justify-content-between py-2">
              <span class="text-muted">
                <%= t("orders.subtotal", default: "Subtotal") %>
              </span>
              <strong>
                <%= number_to_currency(subtotal, unit: "$", precision: 0, delimiter: ".") %>
              </strong>
            </li>
            <% if 20000.to_i > 0 %>
              <li class="d-flex justify-content-between py-2">
                <span class="text-muted">
                  <%= t("orders.discount", default: "Descuento") %>
                </span>
                <strong class="text-success">
                  - <%= number_to_currency(discount, unit: "$", precision: 0, delimiter: ".") %>
                </strong>
              </li>
            <% end %>
          </ul>

          <div class="d-flex justify-content-between pt-3 border-top mt-3 fs-5">
            <strong>
              <%= t("orders.total", default: "Total") %>
            </strong>
            <strong>
              <%= number_to_currency(subtotal - discount, unit: "$", precision: 0, delimiter: ".") %>
            </strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= javascript_tag do %>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.querySelector("form");
    if (!form) return;

    form.addEventListener("submit", function (e) {
      let isValid = true;

      form.querySelectorAll("[required]").forEach(field => {
        const errorDiv = field.parentElement.querySelector(".invalid-feedback");
        if (!field.value.trim()) {
          field.classList.add("is-invalid");
          if (errorDiv) errorDiv.style.display = "block";
          isValid = false;
        } else {
          field.classList.remove("is-invalid");
          if (errorDiv) errorDiv.style.display = "none";
        }
      });

      if (!isValid) {
        e.preventDefault();
        return;
      }

const year = document.querySelector("#expiration_year").value;
const month = document.querySelector("#expiration_month").value.padStart(2, '0');
document.querySelector("#expiration_hidden").value = `${year}/${month}`;

      // Activar spinner
      const spinner = document.querySelector("#spinner");
      const buttonText = document.querySelector("#btn-text");
      spinner.classList.remove("d-none");
      buttonText.textContent = "Procesando...";
    });
  });
<% end %>
