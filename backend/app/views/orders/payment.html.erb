<%# app/views/orders/payment.html.erb %>
<%= stylesheet_link_tag "pay", media: "all" %>

<% subtotal = @order.total.to_f %> <!-- Número puro -->
<% discount = 0 %><br> <!-- Número puro -->

<div class="container py-5">
  <div class="text-center mb-4">
    <h2 class="mt-3 fw-bold"><%= t("order.payment.title") %></h2>
    <p class="text-muted"><%= t("order.payment.security") %></p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-6">
      <%= form_with url: pay_with_card_order_path(@order), method: :post, local: true, scope: nil do %>
        <div class="card-payment p-4 shadow-sm">
          <h5 class="mb-4 fw-semibold"><%= t("order.payment.info") %></h5>
          
          <!-- Campo número de tarjeta -->
          <div class="mb-3">
            <label for="card_number" class="custom-form-label"><%= t("order.payment.card_number") %>:</label>
            <%= text_field_tag :card_number, nil,
              class: "custom-form-input",
              id: "card_number",
              placeholder: "4111 1111 1111 1111",
              required: true,
              inputmode: "numeric",
              pattern: "[0-9 ]*" %>
              <div class="custom-invalid-feedback"><%= t("order.payment.empty_number") %></div>
              <div class="d-flex justify-content-end mt-2">
              <%= image_tag "card_brands.png", alt: "Visa y MasterCard", style: "width: 80px;" %>
            </div>
          </div>

          <!-- Expiración -->
          <div class="mb-3">
            <label for="expiration_select" class="custom-form-label"><%= t("order.payment.expiration_date") %>:</label>
            <div class="d-flex gap-2">
              <%= select_tag :expiration_month,
                options_for_select((1..12).map { |m| [sprintf("%02d", m), sprintf("%02d", m)] }),
                prompt: "MM", class: "custom-form-select", id: "expiration_month", required: true %>

              <%= select_tag :expiration_year,
                options_for_select((Date.today.year..(Date.today.year + 10)).map { |y| [y, y] }),
                prompt: "YYYY", class: "custom-form-select", id: "expiration_year", required: true %>
            </div>
            <div class="custom-invalid-feedback"><%= t("order.payment.empty_date") %></div>
          </div>

          <!-- CVV -->
          <div class="mb-3">
            <label for="cvv" class="custom-form-label"><%= t("order.payment.cvv") %>:</label>
            <%= number_field_tag :cvv, nil, class: "custom-form-input", id: "cvv", placeholder: "123", required: true %>
            <div class="custom-invalid-feedback"><%= t("order.payment.empty_cvv") %></div>
          </div>

          <!-- Nombre en tarjeta -->
          <div class="mb-3">
            <label for="card_name" class="custom-form-label"><%= t("order.payment.name_on_card") %>:</label>
            <%= text_field_tag :card_name, nil, class: "custom-form-input", id: "card_name", placeholder: t("order.payment.name"), required: true %>
            <div class="custom-invalid-feedback"><%= t("order.payment.empty_namecard") %></div>
          </div>


          <%= hidden_field_tag :expiration, "", id: "expiration_hidden" %>
          <%= hidden_field_tag :discount_code_id, "", id: "discount_code_id_hidden" %>

          <button type="submit" class="btn btn-success btn-payu-page w-100 mt-3" id="pay-button">
            <span class="spinner-page d-none" id="spinner" role="status" aria-hidden="true"></span>
            <span id="btn-text"><%= t("order.payment.pay") %></span>
        </button>


          <div class="text-center mt-3">
            <%= image_tag "payu-secure.png", alt: "Paga seguro con PayU", style: "height: 26px;" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
      <div class="card-payment p-4 shadow-sm p-3">
        <h5 class="mb-3 text-center fw-bold">
          <%= t("order.payment.order_summary") %>
        </h5>

        <!-- Productos -->
        <% @order.order_items.each do |item| %>
          <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
            <!-- Imagen del producto -->
            <% if item.product.images.attached? %>
              <%= image_tag url_for(item.product.images.first), class: "rounded me-3", style: "width: 65px; height: 65px; object-fit: cover;" %>
            <% else %>
              <div class="rounded bg-secondary me-3" style="width: 65px; height: 65px;"></div>
            <% end %>

            <!-- Información -->
            <div class="flex-grow-1">
              <div class="fw-semibold fs-6"><%= item.product.name %></div>
              <div class="text-muted small">#<%= item.product.id %></div>
              <% if item.size.present? %>
                <div class="small text-muted"><%= t("order.payment.size") %>: <%= item.size %></div>
              <% end %>
            </div>

            <!-- Cantidad -->
            <div class="text-end small fw-bold ms-2 d-none d-md-block">
              x<%= item.quantity %>
            </div>

            <!-- Subtotal -->
            <div class="fw-bold ms-3 text-nowrap d-none d-md-block">
              <%= number_to_currency(item.price * item.quantity, unit: "$", precision: 0, delimiter: ".") %>
            </div>
          </div>
        <% end %>

        <!-- Campo de Código de Descuento -->
        <div class="mb-3 mt-3">
          <label for="discount_code" class="form-label fw-semibold">Código de Descuento</label>
          <div class="input-group">
            <input type="text" 
                  id="discount_code" 
                  class="form-control" 
                  placeholder="Ingresa tu código"
                  style="text-transform: uppercase;">
            <button type="button" 
                    id="apply_discount_btn" 
                    class="btn btn-outline-primary">
              Aplicar
            </button>
          </div>
          <div id="discount_message" class="form-text"></div>
        </div>

        <!-- Resumen -->
        <div class="border-0 mt-3">
          <ul class="list-unstyled">
            <li class="d-flex justify-content-between py-2">
              <span class="text-muted">
                <%= t("order.payment.subtotal") %>:
              </span>
              <strong id="subtotal_amount">
                <%= number_to_currency(subtotal, unit: "$", precision: 0, delimiter: ".") %>
              </strong>
            </li>
            <li id="discount_line" class="d-flex justify-content-between py-2" style="display: none;">
              <span class="text-muted">
                <%= t("order.payment.discount") %><span id="discount_code_parentheses" style="display: none;"> (<span id="discount_code_display"></span>)</span>:
              </span>
              <strong class="text-success" id="discount_amount">
                - $0
              </strong>
            </li>
          </ul>

          <div class="d-flex justify-content-between pt-3 border-top mt-3 fs-5">
            <strong>
              <%= t("order.payment.total") %>:
            </strong>
            <strong id="total_amount">
              <%= number_to_currency(subtotal - discount, unit: "$", precision: 0, delimiter: ".") %>
            </strong>
          </div>
        </div>
      </div>

      <div class="card__container mt-4">
        <!-- MasterCard -->
        <%= render 'shared/master_card' %>
      </div>
    </div>
  </div>
</div>

<%= javascript_tag do %>
  document.addEventListener("DOMContentLoaded", () => {
    const cardInput = document.getElementById("card_number");
    cardInput.addEventListener("input", () => {
      cardInput.value = cardInput.value.replace(/[^0-9 ]/g, ""); // solo numeros y espacios
    });

    // Variables globales para el descuento
    let appliedDiscount = null;
    const originalSubtotal = <%= @order.total.to_f %>;
    
    // Función para formatear números como moneda
    function formatCurrency(amount) {
      return '$' + new Intl.NumberFormat('es-CO').format(amount);
    }
    
    // Función para actualizar totales
    function updateTotals() {
      const subtotalEl = document.getElementById('subtotal_amount');
      const discountLineEl = document.getElementById('discount_line');
      const discountAmountEl = document.getElementById('discount_amount');
      const discountCodeDisplayEl = document.getElementById('discount_code_display');
      const discountCodeParenthesesEl = document.getElementById('discount_code_parentheses');
      const totalAmountEl = document.getElementById('total_amount');
      
      let discountAmount = 0;
      
      if (appliedDiscount) {
        discountAmount = appliedDiscount.discount_amount;
        discountLineEl.style.display = 'flex';
        discountAmountEl.textContent = '- ' + formatCurrency(discountAmount);
        discountCodeDisplayEl.textContent = appliedDiscount.code;
        discountCodeParenthesesEl.style.display = 'inline';
      } else {
        discountLineEl.style.display = 'none';
        discountAmountEl.textContent = '- $0';
        discountCodeDisplayEl.textContent = '';
        discountCodeParenthesesEl.style.display = 'none';
      }
      
      const finalTotal = originalSubtotal - discountAmount;
      totalAmountEl.textContent = formatCurrency(finalTotal);
    }
    
    // Función para validar código de descuento
    async function validateDiscountCode(code) {
      const applyBtn = document.getElementById('apply_discount_btn');
      const messageEl = document.getElementById('discount_message');
      
      // Mostrar loading
      applyBtn.disabled = true;
      applyBtn.textContent = 'Validando...';
      messageEl.textContent = '';
      messageEl.className = 'form-text';
      
      try {
        const response = await fetch('<%= validate_admin_discount_codes_path %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
          },
          body: JSON.stringify({ code: code })
        });
        
        const result = await response.json();
        
        if (result.valid) {
          // Calcular descuento
          let discountAmount = 0;
          if (result.discount_code.discount_type === 'percentage') {
            discountAmount = Math.round(originalSubtotal * (result.discount_code.value / 100));
          } else {
            discountAmount = Math.min(result.discount_code.value, originalSubtotal);
          }
          
          appliedDiscount = {
            code: result.discount_code.code,
            discount_amount: discountAmount,
            discount_code_id: result.discount_code.id
          };
          
          // Actualizar campo oculto
          document.getElementById('discount_code_id_hidden').value = result.discount_code.id;
          
          updateTotals();
          
          messageEl.textContent = '✓ Código aplicado correctamente';
          messageEl.className = 'form-text text-success';
          
          // Cambiar botón a "Remover"
          applyBtn.textContent = 'Remover';
          applyBtn.className = 'btn btn-outline-danger';
        } else {
          messageEl.textContent = result.message;
          messageEl.className = 'form-text text-danger';
        }
      } catch (error) {
        messageEl.textContent = 'Error al validar el código';
        messageEl.className = 'form-text text-danger';
      } finally {
        applyBtn.disabled = false;
        if (applyBtn.textContent === 'Validando...') {
          applyBtn.textContent = 'Aplicar';
        }
      }
    }
    
    // Event listeners para código de descuento
    const discountCodeInput = document.getElementById('discount_code');
    const applyDiscountBtn = document.getElementById('apply_discount_btn');
    
    // Convertir a mayúsculas automáticamente
    discountCodeInput.addEventListener('input', function() {
      this.value = this.value.toUpperCase();
    });
    
    // Aplicar código al hacer clic en el botón
    applyDiscountBtn.addEventListener('click', function() {
      if (appliedDiscount) {
        // Remover descuento
        appliedDiscount = null;
        document.getElementById('discount_code_id_hidden').value = '';
        updateTotals();
        
        const messageEl = document.getElementById('discount_message');
        messageEl.textContent = '';
        messageEl.className = 'form-text';
        
        discountCodeInput.value = '';
        this.textContent = 'Aplicar';
        this.className = 'btn btn-outline-primary';
      } else {
        // Aplicar descuento
        const code = discountCodeInput.value.trim();
        if (code) {
          validateDiscountCode(code);
        }
      }
    });
    
    // Aplicar código al presionar Enter
    discountCodeInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter' && !appliedDiscount) {
        const code = this.value.trim();
        if (code) {
          validateDiscountCode(code);
        }
      }
    });
  });

  document.addEventListener("DOMContentLoaded", function () {
    const form = document.querySelector("form");
    if (!form) return;

    form.addEventListener("submit", function (e) {
      let isValid = true;

      form.querySelectorAll("[required]").forEach(field => {
        const errorDiv = field.parentElement.querySelector(".invalid-feedback");
        if (!field.value.trim()) {
          field.classList.add("is-invalid");
          if (errorDiv) errorDiv.style.display = "block";
          isValid = false;
        } else {
          field.classList.remove("is-invalid");
          if (errorDiv) errorDiv.style.display = "none";
        }
      });

      if (!isValid) {
        e.preventDefault();
        return;
      }

const year = document.querySelector("#expiration_year").value;
const month = document.querySelector("#expiration_month").value.padStart(2, '0');
document.querySelector("#expiration_hidden").value = `${year}/${month}`;

      // Activar spinner
      const spinner = document.querySelector("#spinner");
      const buttonText = document.querySelector("#btn-text");
      spinner.classList.remove("d-none");
      buttonText.textContent = "<%= j t('order.payment.processing') %>";
    });

    const cardNumberField = document.querySelector("#card_number");
    const cardNameField = document.querySelector("#card_name");
    const expirationMonthField = document.querySelector("#expiration_month");
    const expirationYearField = document.querySelector("#expiration_year");

    const cardNumberDisplay = document.querySelector(".card__number");
    const cardNameDisplay = document.querySelector(".card__name");
    const cardExpDateDisplay = document.querySelector(".card__exp-date");

    // Update card number
    cardNumberField.addEventListener("input", function () {
      const formattedNumber = cardNumberField.value.replace(/[^0-9]/g, "").replace(/(.{4})/g, "$1 ").trim();
      cardNumberDisplay.textContent = formattedNumber || "0123 4567 8901 2345";
    });

    // Update card name
    cardNameField.addEventListener("input", function () {
      cardNameDisplay.textContent = cardNameField.value || "ㅤㅤㅤㅤ";
    });

    // Update expiration date with independent defaults
    function updateExpirationDate() {
      const defaultMonth = "MM";
      const defaultYear = "YYYY";

      const month = expirationMonthField.value.padStart(-2) || defaultMonth;
      const year = expirationYearField.value.slice(-2) || defaultYear;

      cardExpDateDisplay.textContent = `${month}/${year}`;
    }

    expirationMonthField.addEventListener("input", updateExpirationDate);
    expirationYearField.addEventListener("input", updateExpirationDate);
  });
<% end %>
