<!-- Header con título y navegación -->
<div class="titulo-res mb-4 d-flex justify-content-between align-items-center">
  <h1 class="fw-bold">
    Editar Usuario
  </h1>
</div>

<!-- Card del formulario -->
<div class="table-responsive table-personalized">
  <div class="row g-0">
    <!-- Columna principal del formulario -->
    <div class="col-12 col-lg-8">
      <div class="p-4">
        <%= render 'shared/form_errors', object: @user %>
        
        <%= form_with model: [:admin, @user], local: true, class: "needs-validation", novalidate: true do |form| %>
          
          <!-- Información Personal -->
          <div class="mb-4">
            
            <div class="row g-4">
              <div class="col-md-6">
                <div class="input-container">
                  <%= form.label :name, "Nombre", class: "input-label" %>
                  <%= form.text_field :name, 
                      class: "custom-input #{'border-danger' if @user.errors[:name].any?}", 
                      placeholder: "Ingresa tu nombre",
                      required: true %>
                  <% if @user.errors[:name].any? %>
                    <div class="text-danger small mt-1">
                      <i class="bi bi-exclamation-circle me-1"></i>
                      <%= @user.errors[:name].first %>
                    </div>
                  <% end %>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="input-container">
                  <%= form.label :last_name, "Apellido", class: "input-label" %>
                  <%= form.text_field :last_name, 
                      class: "custom-input #{'border-danger' if @user.errors[:last_name].any?}", 
                      placeholder: "Ingresa tu apellido",
                      required: true %>
                  <% if @user.errors[:last_name].any? %>
                    <div class="text-danger small mt-1">
                      <i class="bi bi-exclamation-circle me-1"></i>
                      <%= @user.errors[:last_name].first %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Información de Contacto -->
          <div class="mb-4">
            
            <div class="row g-4">
              <div class="col-md-6">
                <div class="input-container">
                  <%= form.label :email, "Correo Electrónico", class: "input-label" %>
                  <%= form.email_field :email, 
                      class: "custom-input #{'border-danger' if @user.errors[:email].any?}", 
                      placeholder: "usuario@ejemplo.com",
                      required: true %>
                  <% if @user.errors[:email].any? %>
                    <div class="text-danger small mt-1">
                      <i class="bi bi-exclamation-circle me-1"></i>
                      <%= @user.errors[:email].first %>
                    </div>
                  <% end %>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="input-container">
                  <%= form.label :phone, "Teléfono", class: "input-label" %>
                  <%= form.text_field :phone, 
                      class: "custom-input #{'border-danger' if @user.errors[:phone].any?}", 
                      placeholder: "+57 300 123 4567" %>
                  <% if @user.errors[:phone].any? %>
                    <div class="text-danger small mt-1">
                      <i class="bi bi-exclamation-circle me-1"></i>
                      <%= @user.errors[:phone].first %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Información de Ubicación -->
          <div class="mb-4">
            
            <div class="row g-4">
              <div class="col-md-6">
                <div class="input-container">
                  <%= form.label :city, "Ciudad", class: "input-label" %>
                  <%= form.text_field :city, 
                      class: "custom-input #{'border-danger' if @user.errors[:city].any?}", 
                      placeholder: "Medellín, Bogotá, Cali..." %>
                  <% if @user.errors[:city].any? %>
                    <div class="text-danger small mt-1">
                      <i class="bi bi-exclamation-circle me-1"></i>
                      <%= @user.errors[:city].first %>
                    </div>
                  <% end %>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="input-container">
                  <%= form.label :address, "Dirección", class: "input-label" %>
                  <%= form.text_field :address, 
                      class: "custom-input #{'border-danger' if @user.errors[:address].any?}", 
                      placeholder: "Calle 123 # 45-67" %>
                  <% if @user.errors[:address].any? %>
                    <div class="text-danger small mt-1">
                      <i class="bi bi-exclamation-circle me-1"></i>
                      <%= @user.errors[:address].first %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Configuración de Cuenta -->
          <div class="mb-4">
            
            <div class="row g-4">
              <div class="col-md-6">
                <div class="input-container">
                  <%= form.label :role, "Rol del Usuario", class: "input-label" %>
                  <%= form.select :role, 
                      [['Usuario Regular', 'user'], ['Administrador', 'admin']], 
                      { selected: @user.role }, 
                      { class: "custom-input #{'border-danger' if @user.errors[:role].any?}" } %>
                  <% if @user.errors[:role].any? %>
                    <div class="text-danger small mt-1">
                      <i class="bi bi-exclamation-circle me-1"></i>
                      <%= @user.errors[:role].first %>
                    </div>
                  <% end %>
                </div>
              </div>
              
              <div class="col-md-6">
                <div class="input-container">
                  <%= form.label :password, "Nueva Contraseña (opcional)", class: "input-label" %>
                  <%= form.password_field :password, 
                      class: "custom-input", 
                      placeholder: "Dejar vacío para mantener actual" %>
                  <div class="form-text small text-muted mt-1">
                    <i class="bi bi-info-circle me-1"></i>
                    Solo completa si deseas cambiar la contraseña
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Botones de acción -->
          <div class="d-flex gap-3 pt-3">
            <%= form.submit "Guardar Cambios", class: "cssbuttons-io-button" %>
            <%= link_to admin_user_path(@user), class: "cssbuttons-io-button-secondary" do %>
              <svg height="16" width="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 12H5m7-7l-7 7 7 7" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Volver</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Sidebar con información del usuario -->
    <div class="col-12 col-lg-4 border-start">
      <div class="p-4">
        <!-- Avatar del usuario -->
        <div class="text-center mb-4">
          <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 100px; height: 100px;">
            <i class="bi bi-person-fill fs-1 text-white"></i>
          </div>
          <h5 class="mb-1"><%= @user.name %> <%= @user.last_name %></h5>
          <p class="text-muted small mb-0"><%= @user.email %></p>
          <span class="badge mt-2 <%= @user.admin? ? 'bg-danger-ok' : 'bg-secondary-ok' %>">
            <%= @user.admin? ? "Administrador" : "Usuario" %>
          </span>
        </div>

        <!-- Información adicional -->
        <div class="border-top pt-4">
          <h6 class="text-muted mb-3">Información de la Cuenta</h6>
          
          <div class="mb-3">
            <small class="text-muted d-block">ID del Usuario</small>
            <span class="fw-semibold">#<%= @user.id %></span>
          </div>
          
          <div class="mb-3">
            <small class="text-muted d-block">Fecha de Registro</small>
            <span class="fw-semibold"><%= @user.created_at.strftime("%d/%m/%Y") %></span>
          </div>
          
          <div class="mb-3">
            <small class="text-muted d-block">Última Actualización</small>
            <span class="fw-semibold"><%= @user.updated_at.strftime("%d/%m/%Y") %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
