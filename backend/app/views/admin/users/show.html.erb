<!-- Header con título y acciones -->
<div class="titulo-res mb-4 d-flex justify-content-between align-items-center">
  <h1 class="fw-bold">
    Detalles del Usuario
  </h1>
  
  <div class="d-flex">    
    <%= link_to edit_admin_user_path(@user), class: "cssbuttons-io-button" do %>
      <svg height="16" width="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="currentColor"/>
      </svg>
      <span>Editar Usuario</span>
    <% end %>
  </div>
</div>

<!-- Card principal con información del usuario -->
<div class="table-responsive table-personalized mb-4">
  <div class="row g-0">
    <!-- Columna izquierda - Información personal -->
    <div class="col-12 col-lg-8">
      <div class="p-4">
        <!-- Header del usuario -->
        <div class="d-flex align-items-center mb-4">
          <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 80px; height: 80px;">
            <i class="bi bi-person-fill fs-1 text-white"></i>
          </div>
          <div>
            <h3 class="mb-1 fw-bold"><%= @user.name %> <%= @user.last_name %></h3>
            <p class="text-muted mb-0">
              <%= @user.email %>
            </p>
          </div>
        </div>

        <!-- Información en grid -->
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="bi bi-geo-alt-fill text-danger me-3 fs-5"></i>
              <div>
                <small class="text-muted d-block">Ciudad</small>
                <span class="fw-semibold"><%= @user.city %></span>
              </div>
            </div>
          </div>
          
          <div class="col-12 col-md-6">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="bi bi-house-fill text-success me-3 fs-5"></i>
              <div>
                <small class="text-muted d-block">Dirección</small>
                <span class="fw-semibold"><%= @user.address %></span>
              </div>
            </div>
          </div>
          
          <div class="col-12 col-md-6">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="bi bi-telephone-fill text-info me-3 fs-5"></i>
              <div>
                <small class="text-muted d-block">Teléfono</small>
                <span class="fw-semibold"><%= @user.phone %></span>
              </div>
            </div>
          </div>
          
          <div class="col-12 col-md-6">
            <div class="d-flex align-items-center p-3 bg-light rounded">
              <i class="bi bi-calendar-check-fill text-warning me-3 fs-5"></i>
              <div>
                <small class="text-muted d-block">Fecha de registro</small>
                <span class="fw-semibold"><%= @user.created_at.strftime("%d/%m/%Y") %></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna derecha - Metadata y acciones -->
    <div class="col-12 col-lg-4 border-start">
      <div class="p-4">
        <!-- ID del usuario -->
        <div class="mb-4">
          <h5 class="text-muted mb-2">
            ID del Usuario
          </h5>
          <span class="badge bg-light text-dark fs-6 px-3 py-2">#<%= @user.id %></span>
        </div>

        <!-- Rol del usuario -->
        <div class="mb-4">
          <h5 class="text-muted mb-2">
            Rol del Sistema
          </h5>
          <span class="badge fs-6 px-3 py-2 <%= @user.admin? ? 'bg-danger-ok' : 'bg-secondary-ok' %>">
            <i class="bi bi-<%= @user.admin? ? 'shield-fill-check' : 'person-fill' %> me-2"></i>
            <%= @user.admin? ? "Administrador" : "Usuario" %>
          </span>
        </div>

        <!-- Estado de la cuenta -->
        <div class="mb-4">
          <h5 class="text-muted mb-2">
            Estado de Cuenta
          </h5>
          <span class="badge bg-secondary-ok fs-6 px-3 py-2">
            <i class="bi bi-check-circle-fill me-2"></i>
            Activa
          </span>
        </div>

        <!-- Acciones peligrosas -->
        <div class="border-top pt-4">
          <h6 class="text-danger mb-3">
            Zona de Peligro
          </h6>
          <%= button_to admin_user_path(@user),
              method: :delete,
              form: { data: { turbo: false } },
              onclick: "return confirm('¿Estás seguro de que quieres eliminar este usuario?\\n\\nEsta acción no se puede deshacer.')",
              class: 'btn btn-outline-danger w-100' do %>
            <i class="bi bi-trash-fill me-2"></i>
            Eliminar Usuario
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
