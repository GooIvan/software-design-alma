<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-body">
        <%= form_with model: [:admin, @discount_code], local: true, class: "needs-validation", novalidate: true do |form| %>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <%= form.label :code, "Código", class: "form-label" %>
                <%= form.text_field :code, class: "form-control #{'is-invalid' if @discount_code.errors[:code].any?}", 
                    placeholder: "Ej: DESCUENTO20", style: "text-transform: uppercase;", required: true %>
                <% if @discount_code.errors[:code].any? %>
                  <div class="invalid-feedback">
                    <%= @discount_code.errors[:code].first %>
                  </div>
                <% end %>
              </div>

              <div class="mb-3">
                <%= form.label :discount_type, "Tipo de Descuento", class: "form-label" %>
                <%= form.select :discount_type, 
                    options_for_select([
                      ['Porcentaje', 'percentage'],
                      ['Monto Fijo', 'fixed_amount']
                    ], @discount_code.discount_type), 
                    { prompt: "Selecciona un tipo" }, 
                    { class: "form-select #{'is-invalid' if @discount_code.errors[:discount_type].any?}", required: true } %>
                <% if @discount_code.errors[:discount_type].any? %>
                  <div class="invalid-feedback">
                    <%= @discount_code.errors[:discount_type].first %>
                  </div>
                <% end %>
              </div>

              <div class="mb-3">
                <%= form.label :value, "Valor", class: "form-label" %>
                <div class="input-group">
                  <span class="input-group-text" id="value-addon">
                    <span id="currency-symbol">$</span>
                  </span>
                  <%= form.number_field :value, class: "form-control #{'is-invalid' if @discount_code.errors[:value].any?}", 
                      step: 0.01, min: 0, required: true, "aria-describedby": "value-addon" %>
                  <% if @discount_code.errors[:value].any? %>
                    <div class="invalid-feedback">
                      <%= @discount_code.errors[:value].first %>
                    </div>
                  <% end %>
                </div>
                <div class="form-text" id="value-help">
                  Para porcentaje: valor entre 1-100. Para monto fijo: cantidad en pesos.
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="mb-3">
                <%= form.label :expires_at, "Fecha de Expiración", class: "form-label" %>
                <%= form.datetime_local_field :expires_at, 
                    class: "form-control #{'is-invalid' if @discount_code.errors[:expires_at].any?}" %>
                <% if @discount_code.errors[:expires_at].any? %>
                  <div class="invalid-feedback">
                    <%= @discount_code.errors[:expires_at].first %>
                  </div>
                <% else %>
                  <div class="form-text">
                    Deja vacío para que no expire nunca.
                  </div>
                <% end %>
              </div>

              <div class="mb-3">
                <%= form.label :max_uses, "Límite Total de Usos", class: "form-label" %>
                <%= form.number_field :max_uses, class: "form-control", min: 1 %>
                <div class="form-text">
                  Deja vacío para usos ilimitados.
                </div>
              </div>

              <div class="mb-3">
                <%= form.label :max_uses_per_user, "Límite de Usos por Usuario", class: "form-label" %>
                <%= form.number_field :max_uses_per_user, class: "form-control", min: 1 %>
                <div class="form-text">
                  Deja vacío para que cada usuario pueda usar el código ilimitadas veces.
                </div>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-12">
              <div class="mb-3">
                <%= form.label :user_id, "Usuario Específico (Opcional)", class: "form-label" %>
                <%= form.select :user_id, 
                    options_from_collection_for_select(User.all, :id, :email, @discount_code.user_id), 
                    { prompt: "Todos los usuarios pueden usar este código" }, 
                    { class: "form-select" } %>
              </div>

              <div class="form-check mb-3">
                <%= form.check_box :active, class: "form-check-input", checked: true %>
                <%= form.label :active, "Código activo", class: "form-check-label" %>
              </div>
            </div>
          </div>

          <div class="d-flex gap-2">
            <%= form.submit "Crear Código de Descuento", class: "btn btn-primary" %>
            <%= link_to "Cancelar", admin_discount_codes_path, class: "btn btn-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const discountTypeSelect = document.getElementById('discount_code_discount_type');
  const currencySymbol = document.getElementById('currency-symbol');
  const valueHelp = document.getElementById('value-help');
  
  function updateValueDisplay() {
    const isPercentage = discountTypeSelect.value === 'percentage';
    currencySymbol.textContent = isPercentage ? '%' : '$';
    valueHelp.textContent = isPercentage 
      ? 'Ingresa un valor entre 1 y 100 para el porcentaje de descuento.'
      : 'Ingresa la cantidad en pesos que se descontará del total.';
  }
  
  discountTypeSelect.addEventListener('change', updateValueDisplay);
  updateValueDisplay(); // Ejecutar al cargar la página
  
  // Convertir código a mayúsculas automáticamente
  const codeInput = document.getElementById('discount_code_code');
  codeInput.addEventListener('input', function() {
    this.value = this.value.toUpperCase();
  });
});
</script>