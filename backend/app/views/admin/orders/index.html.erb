<div class="titulo-res mb-4 d-flex justify-content-between align-items-center">
  <h1 class="fw-bold"><%= t('admin.orders.orders') %></h1>
  <%= link_to new_admin_order_path, class: "cssbuttons-io-button" do %>
    <svg
      height="24"
      width="24"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M0 0h24v24H0z" fill="none"></path>
      <path d="M11 11V5h2v6h6v2h-6v6h-2v-6H5v-2z" fill="currentColor"></path>
    </svg>
    <span><%= t("admin.orders.create_order") %></span>
  <% end %>
</div>

<div class="row g-3 mb-4">
  <!-- Filtro por estado -->
  <div class="col-12 col-md-3">
    <%= form_with url: admin_orders_path(locale: I18n.locale), method: :get, local: true do %>
      <%# Mantener filtros activos %>
      <%= hidden_field_tag :id, params[:id] if params[:id].present? %>
      <%= hidden_field_tag :user_email, params[:user_email] if params[:user_email].present? %>

      <label class="form-label fw-semibold text-muted mb-1">
        <i class="bi bi-funnel-fill me-1 text-primary"></i> <%= t('admin.orders.status') %>
      </label>
      <%= select_tag :status,
        options_for_select(@statuses.prepend(t("all")), params[:status]),
        class: "form-select shadow-sm", onchange: "this.form.submit()", style: "height: 50px;" %>
    <% end %>
  </div>

  <!-- Filtro por ID -->
  <div class="col-12 col-md-3">
    <%= form_with url: admin_orders_path(locale: I18n.locale), method: :get, local: true do %>
      <%# Mantener filtros activos %>
      <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
      <%= hidden_field_tag :user_email, params[:user_email] if params[:user_email].present? %>

      <label class="form-label fw-semibold text-muted mb-1">
        <i class="bi bi-hash me-1 text-primary"></i> <%= t('admin.orders.id') %>
      </label>
      <div class="input-group shadow-sm">
        <%= text_field_tag :id, params[:id], class: "form-control", placeholder: "Ej: 101", style: "height: 50px;" %>
      </div>
    <% end %>
  </div>

  <!-- Filtro por Email -->
  <div class="col-12 col-md-6">
    <%= form_with url: admin_orders_path(locale: I18n.locale), method: :get, local: true do %>
      <%# Mantener filtros activos %>
      <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
      <%= hidden_field_tag :id, params[:id] if params[:id].present? %>

      <label class="form-label fw-semibold text-muted mb-1">
        <i class="bi bi-search me-1 text-primary"></i> <%= t('admin.orders.user') %>
      </label>
      <div class="input-group shadow-sm">
        <%= text_field_tag :user_email, params[:user_email], class: "form-control", placeholder: "user@example.com", style: "height: 50px;" %>
      </div>
    <% end %>
  </div>
</div>

<% total_results = @orders.count %>
<% status_filter = params[:status].present? && !["all", "todas"].include?(params[:status].downcase) %>
<% email_filter = params[:user_email].present? %>
<% id_filter = params[:id].present? %>

<% if total_results > 0 && (status_filter || email_filter || id_filter) %>
  <p class="text-muted px-4 fw-semibold">
    <%= t("results_found#{'_plural' if total_results > 1}", count: total_results).html_safe %>
  </p>
<% end %>

<% if status_filter || email_filter || id_filter %>
  <div class="d-flex align-items-center px-4 mb-4">
    <div>
      <% if status_filter %>
        <span class="me-3">
          <strong><%= t('status') %></strong>
          <span class="ms-2 bg-gray"><%= params[:status] %></span>
        </span>
      <% end %>

      <% if id_filter %>
        <span class="me-3">
          <strong><%= t('orders.id') %></strong>
          <span class="ms-2 bg-gray"><%= params[:id] %></span>
        </span>
      <% end %>

      <% if email_filter %>
        <span class="me-3">
          <strong><%= t('orders.user') %></strong>
          <span class="ms-2 bg-gray"><%= params[:user_email] %></span>
        </span>
      <% end %>
    </div>

    <%= link_to admin_orders_path(locale: I18n.locale), class: "clear-bt text-danger text-decoration-none fw-bold" do %>
      <i class="bi bi-trash-fill hover-opacity"></i>
      <span><%= t('clear') %></span>
    <% end %>
  </div>
<% end %>

<%= form_with url: "/#{I18n.locale}/admin/orders/bulk_delete", method: :delete do %>
  <div class="table-responsive table-personalized">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr id="selection-bar" class="d-none">
          <th colspan="6" class="text-white bg-selected px-4 rounded">
            <div class="d-flex justify-content-between align-items-center w-100">
              <span id="selection-count"></span>
              <button type="submit" class="btn p-0 border-0 bg-transparent text-primary">
                <i class="bi bi-trash-fill fs-4 hover-opacity"></i>
              </button>
            </div>
          </th>
        </tr>
        <tr class="table-light no-thead-border">
          <th style="width: 2%;"><input type="checkbox" id="select-all"></th>
          <th style="width: 50%;"><%= t('admin.orders..id') %> / <%= t('admin.orders..user') %></th>
          <th class="d-none d-md-table-cell text-center text-nowrap" style="width: 14%;"><%= t('admin.orders.total') %></th>
          <th class="d-none d-md-table-cell text-center text-nowrap" style="width: 14%;"><%= t('admin.orders.date') %></th>
          <th class="d-none d-md-table-cell text-center text-nowrap" style="width: 14%;"><%= t('admin.orders.status') %></th>
          <th class="d-none d-md-table-cell text-center text-nowrap" style="width: 14%;"><%= t('admin.orders.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td>
              <input type="checkbox" name="selected_orders[]" value="<%= order.id %>" class="order-checkbox">
            </td>

            <!-- ID + Email a la izquierda -->
            <td>
              <div class="fw-bold">#<%= order.id %></div>
              <div class="text-muted small"><%= order.user.email %></div>

              <!-- Para móvil -->
              <div class="d-md-none mt-2">
                <% 
                  subtotal = order.order_items.sum { |item| item.price * item.quantity }
                  discount_amount = order.discount_amount || 0
                  if discount_amount == 0 && order.discount_usage.present?
                    discount_amount = order.discount_usage.discount_amount
                  end
                  final_total = subtotal - (discount_amount || 0)
                %>
                
                <% if order.discount_code.present? && discount_amount > 0 %>
                  <div>
                    <small class="text-muted">Subtotal: $<%= number_to_currency(subtotal, unit: "", precision: 0) %></small><br>
                    <small class="text-success">Descuento (<%= order.discount_code.code %>): -$<%= number_to_currency(discount_amount, unit: "", precision: 0) %></small><br>
                    <strong><%= t('orders.total') %>: $<%= number_to_currency(final_total, unit: "", precision: 0) %></strong>
                  </div>
                <% else %>
                  <div><strong><%= t('orders.total') %>:</strong> $<%= number_to_currency(final_total, unit: "", precision: 0) %></div>
                <% end %>
              </div>

              <!-- Responsive extra info (solo visible en pantallas pequeñas) -->
              <div class="d-md-none mt-2 d-flex justify-content-between align-items-center">
                <!-- Botón ver en móvil -->
                <%= link_to admin_order_path(order), class: 'btn btn-sm' do %>
                  <i class="bi bi-eye-fill fs-4 hover-opacity"></i>
                <% end %>
                <%= button_to admin_order_path(order),
                    method: :delete,
                    data: { confirm: "¿Estás seguro de que deseas eliminar esta orden?" },
                    class: 'btn p-0 border-0 bg-transparent text-danger mx-1' do %>
                  <i class="bi bi-trash-fill fs-4 hover-opacity"></i>
                <% end %>
              </div>              
            </td>

            <!-- Columnas visibles solo en escritorio -->
            <td class="d-none d-md-table-cell text-center px-1">
              <% 
                subtotal = order.order_items.sum { |item| item.price * item.quantity }
                discount_amount = order.discount_amount || 0
                if discount_amount == 0 && order.discount_usage.present?
                  discount_amount = order.discount_usage.discount_amount
                end
                final_total = subtotal - (discount_amount || 0)
              %>
              
              <% if order.discount_code.present? && discount_amount > 0 %>
                <div class="order-discount-info-admin">
                  <small class="text-muted d-block">$<%= number_to_currency(subtotal, unit: "", precision: 0) %></small>
                  <small class="text-success d-block">-$<%= number_to_currency(discount_amount, unit: "", precision: 0) %></small>
                  <strong class="text-dark">$<%= number_to_currency(final_total, unit: "", precision: 0) %></strong>
                </div>
              <% else %>
                <strong>$<%= number_to_currency(final_total, unit: "", precision: 0) %></strong>
              <% end %>
            </td>
            <td class="d-none d-md-table-cell text-center text-nowrap px-1"><%= l(order.created_at, format: :short) %></td>
            <td class="d-none d-md-table-cell text-center text-nowrap px-1">
              <span class="badge 
                <%= case order.status
                    when 'paid' then 'bg-secondary-ok'
                    when 'pending' then 'bg-pending-ok'
                    when 'cancelled' then 'bg-danger-ok'
                    end %>">
                <%= order.status.capitalize %>
              </span>
            </td>
            <td class="d-none d-md-table-cell text-center text-nowrap px-1">
              <div class="d-flex justify-content-center">
                <%= link_to admin_order_path(order), class: 'text-decoration-none text-body mx-1' do %>
                  <i class="bi bi-eye-fill fs-4 hover-opacity"></i>
                <% end %>

                <%= button_to admin_order_path(order),
                    method: :delete,
                    data: { confirm: "¿Estás seguro de que deseas eliminar esta orden?" },
                    class: 'btn p-0 border-0 bg-transparent text-danger mx-1' do %>
                  <i class="bi bi-trash-fill fs-4 hover-opacity"></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<script>
  document.addEventListener("turbo:load", function () {
    const selectAll = document.getElementById("select-all");
    const checkboxes = document.querySelectorAll(".order-checkbox");
    const selectionBar = document.getElementById("selection-bar");
    const selectionCount = document.getElementById("selection-count");

    function updateSelectionUI() {
      const selected = document.querySelectorAll(".order-checkbox:checked").length;
      if (selected > 0) {
        selectionBar.classList.remove("d-none");
        selectionCount.textContent = `${selected} seleccionadas`;
      } else {
        selectionBar.classList.add("d-none");
        selectionCount.textContent = "";
      }
    }

    if (selectAll) {
      selectAll.addEventListener("change", function () {
        checkboxes.forEach(cb => cb.checked = selectAll.checked);
        updateSelectionUI();
      });
    }

    checkboxes.forEach(cb => {
      cb.addEventListener("change", () => {
        selectAll.checked = [...checkboxes].every(c => c.checked);
        updateSelectionUI();
      });
    });

    updateSelectionUI();
  });
</script>
