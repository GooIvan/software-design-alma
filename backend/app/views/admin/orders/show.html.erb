<h2 class="titulo-res fw-bold">
  <%= t("admin.orders.order") %> #<%= @order.id %>
  <span class="ms-2 badge 
    <%= case @order.status
        when 'paid' then 'bg-secondary-ok'
        when 'pending' then 'bg-pending-ok'
        when 'cancelled' then 'bg-danger-ok'
        end %>">
    <%= @order.status.capitalize %>
  </span>
</h2>
<p class="text-muted"><%= l(@order.created_at, format: :short) %></p>
<% subtotal = @order.total.to_f %> <!-- Número puro -->
<% discount = 0 %><br> <!-- Número puro -->

<div class="gap-3 div-cards">
  <div class="cards p-4 w-66 d-flex flex-column">

    <!-- CAJA 1: Detalles de productos -->
    <div>
      <p class='fs-5 fw-bold'>
        <%= t('admin.orders.details') %>
      </p>

      <!-- fila de productos -->
      <% @order.order_items.each do |item| %>
        <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
          <!-- Imagen del producto -->
          <% if item.product.image.attached? %>
            <%= image_tag url_for(item.product.image), class: "rounded me-4", style: "width: 65px; height: 65px; object-fit: cover;" %>
          <% else %>
            <div class="rounded me-4" style="width: 65px; height: 65px; background-color: red;"></div>
          <% end %>

          <!-- Información del producto -->
          <div class="flex-grow-1">
            <div class="fw-semibold fs-6"><%= item.product.name %></div>
            <div class="text-muted small">#<%= item.product.id %></div>
          </div>

          <!-- Talla (oculta en móviles) -->
          <div class="text-end fw-semibold me-5 small d-none d-md-block">
            <%= item.size %>
          </div>

          <!-- Cantidad (oculta en móviles) -->
          <div class="text-end fw-semibold me-5 small d-none d-md-block">
            x<%= item.quantity %>
          </div>

          <!-- Subtotal (oculta en móviles) -->
          <div class="fw-bold fs-6 d-none d-md-block">
            $<%= number_to_currency(item.price * item.quantity, unit: "", precision: 0) %>
          </div>
        </div>
      <% end %>

      <div class="border-0">
        <div class="card-body">

          <ul class="list-unstyled">
            <li class="d-flex justify-content-between py-2">
              <span class="text-muted"><%= t("admin.orders.subtotal") %></span>
              <strong>$<%= number_to_currency(subtotal, unit: "", precision: 0) %></strong>
            </li>
            <li class="d-flex justify-content-between py-2">
              <span class="text-muted"><%= t("admin.orders.discount") %></span>
              <strong class="text-success">- $<%= number_to_currency(discount, unit: "", precision: 0) %></strong>
            </li>
          </ul>

          <div class="d-flex justify-content-between pt-3">
            <strong><%= t("admin.orders.total") %></strong>
            <strong>$<%= number_to_currency(subtotal - discount, unit: "", precision: 0) %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- BOX 2: Details user -->
  <div class="cards p-4 d-flex flex-column w-100" style="max-width: 500px;">
    <p class='fs-5 fw-bold'><%= t("admin.orders.customer_info") %></p>

    <div class="d-flex flex-row gap-1 fw-bold" style="margin-bottom: -10px;">
      <p><%= @order.user.name%></p>
      <p><%= @order.user.last_name%></p>
    </div>

    <p class="text-muted fs-7"><%= @order.user.email %></p>

    <p class='fs-5 fw-bold'><%= t("admin.orders.shipping") %></p>

    <div class="d-flex flex-row gap-5 text-shiping">
      <div class="column">
        <p class="text-muted"> City </p>
        <p class="text-muted"> Address </p>
        <p class="text-muted"> Phone </p>
      </div>
      <div class="row">
        <p><%= @order.user.city %></p>
        <p><%= @order.user.address %></p>
        <p><%= @order.user.phone %></p>
      </div>
    </div>

    <p class='fs-5 fw-bold mb-4'><%= t("admin.orders.payment") %></p>
    <div class="d-flex flex-row justify-content-end gap-2">
      <p class="text-muted">**** **** **** 1111</p>
