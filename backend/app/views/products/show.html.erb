<div class="m-3">
    <%= render 'shared/form_errors', object: @product%>
    <%= render 'shared/form_exited', object: @product%>
</div>

<%= stylesheet_link_tag 'product_style', media: 'all' %>

<div class="container py-5 mb-6">
  <div class="row align-items-start hellstar-product-layout">
    <!-- Galería de imágenes del producto -->
    <div class="col-md-6">
      <% if @product.images.attached? && @product.images.first.present? %>
        <!-- Imagen principal -->
        <div class="main-image-container mb-3">
          <%= image_tag @product.images.first, 
              alt: @product.name, 
              class: "img-fluid",
              id: "mainProductImage",
              style: "width: 100%; height: 500px; object-fit: cover; border-radius: 10px;" %>
        </div>
        
        <!-- Miniaturas -->
        <% if @product.images.count > 1 %>
          <div class="d-flex gap-2 flex-wrap justify-content-center">
            <% @product.images.each_with_index do |img, index| %>
              <div class="thumbnail-container <%= 'active' if index == 0 %>" data-index="<%= index %>">
                <%= image_tag img, 
                    class: "product-thumbnail", 
                    style: "width: 80px; height: 80px; object-fit: cover; border-radius: 8px; cursor: pointer; border: 2px solid #ddd; transition: all 0.3s ease;",
                    data: { image_url: url_for(img) },
                    onclick: "changeMainImage(this.dataset.imageUrl, this)" %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px; border-radius: 10px;">
          <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
        </div>
      <% end %>
    </div>

    <!-- Detalles del producto -->
    <div class="col-md-6">
      <div class="d-flex justify-content-between align-items-center mb-3">

        <!-- Nombre del producto -->
        <h2 class="hellstar-title m-0"><%= @product.name.upcase %></h2>

        <!-- Botón de favorito -->
        <% favorite = current_user&.favorites&.find_by(product_id: @product.id) %>

        <% if current_user.nil? %>
          <!-- Usuario NO logueado → redirige a login -->
          <%= link_to new_user_session_path,
                class: "btn btn-light d-flex align-items-center justify-content-center rounded-circle",
                style: "width: 50px; height: 50px;" do %>
            <i class="bi bi-heart" style="font-size: 1.3rem;"></i>
          <% end %>

        <% elsif favorite.present? %>
          <!-- Ya es favorito → botón para eliminar -->
          <%= button_to favorite_path(favorite),
                method: :delete,
                class: "btn btn-danger d-flex align-items-center justify-content-center rounded-circle",
                style: "width: 50px; height: 50px;" do %>
            <i class="bi bi-heart-fill" style="font-size: 1.3rem;"></i>
          <% end %>
        <% else %>
          <!-- No es favorito → botón para agregar -->
          <%= button_to favorites_path(product_id: @product.id),
                method: :post,
                class: "btn btn-light d-flex align-items-center justify-content-center rounded-circle",
                style: "width: 50px; height: 50px;" do %>
            <i class="bi bi-heart" style="font-size: 1.3rem;"></i>
          <% end %>
        <% end %>

      </div>

      <% if (2..5).include?(@product.stock) %>
        <div class="alert alert-warning fw-semibold mt-2">
          <%= t("products.low_stock_plural", count: @product.stock) %>
        </div>
      <% elsif @product.stock == 1 %>
        <div class="alert alert-warning fw-semibold mt-2">
          <%= t("products.low_stock_singular") %>
        </div>
      <% elsif @product.stock == 0 %>
        <div class="alert alert-danger fw-semibold mt-2">
          <%= t("products.sold_out") %>
        </div>
      <% end %>

      <p class="hellstar-price mb-3"><%= number_to_currency(@product.price, unit: "$", precision: 0) %></p>

      <p class="mb-4 text-muted"><%= @product.description %></p>

      <!-- Formulario -->
      <%= form_with url: cart_items_path, method: :post, local: true, html: { class: "open-cart-on-submit" } do |f| %>
        <%= f.hidden_field :product_id, value: @product.id %>

        <!-- Tallas -->
        <% if @product.stock > 0 %>
          <div class="mb-3">
            <label class="form-label fw-bold"><%= t("products.size") %></label>
            <div class="d-flex flex-wrap gap-3 mt-2">
              <% @product.sizes.each_with_index do |size, index| %>
                <%= f.radio_button :size, size, id: "size_#{size}", class: "btn-check", checked: index == 0 %>
                <label class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold size-option" for="size_<%= size %>">
                  <%= size %>
                </label>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="mb-3">
            <label class="form-label fw-bold"><%= t("products.size") %></label>
            <div class="d-flex flex-wrap gap-3 mt-2">
              <% @product.sizes.each_with_index do |size, index| %>
                <input type="radio" disabled class="btn-check">
                <label class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold size-option" for="size_<%= size %>">
                  <%= size %>
                </label>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Cantidad -->
        <div class="mb-3">
          <label class="form-label fw-bold"><%= t("products.quantity") %></label>
          <% if @product.stock == 0 %>
            <%= f.select :quantity, options_for_select(1..9), {}, class: "form-select rounded-pill w-auto px-4 py-2 fw-semibold", disabled: true %>
          <% else %>
            <%= f.select :quantity, options_for_select(1..9), {}, class: "form-select rounded-pill w-auto px-4 py-2 fw-semibold" %>
          <% end %>
        </div>

        <% if @product.stock == 0 %>
          <button class="btn btn-secondary w-100 fw-bold" style="pointer-events: none; border-radius: 20px; width: 100%; height: 50px;" disabled>
            <%= t('products.sold_out') %>
          </button>
        <% else %>
          <%= f.submit t("products.add_to_cart"), class: "btn btn-dark w-100 hellstar-add-to-cart", style: "border-radius: 20px; width: 100%;" %>
        <% end  %>
      <% end %>
    </div>
  </div>
</div>

<!-- JS: abrir carrito al añadir -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const forms = document.querySelectorAll("form.open-cart-on-submit");

    forms.forEach(form => {
      form.addEventListener("submit", () => {
        const sideCart = document.getElementById("side-cart");
        if (sideCart) {
          sideCart.classList.remove("hidden");
          requestAnimationFrame(() => {
            sideCart.classList.add("open");
          });
        }
      });
    });
  });

  // Función para cambiar la imagen principal
  function changeMainImage(imageUrl, thumbnailElement) {
    const mainImage = document.getElementById('mainProductImage');
    mainImage.src = imageUrl;
    
    // Remover clase activa de todas las miniaturas
    document.querySelectorAll('.thumbnail-container').forEach(thumb => {
      thumb.classList.remove('active');
    });
    
    // Agregar clase activa a la miniatura seleccionada
    thumbnailElement.closest('.thumbnail-container').classList.add('active');
  }
</script>

<style>
  /* Estilos para la galería de imágenes */
  .thumbnail-container.active .product-thumbnail {
    border-color: #007bff !important;
    transform: scale(1.05);
  }
  
  .product-thumbnail:hover {
    border-color: #007bff !important;
    transform: scale(1.02);
  }
  
  .main-product-image {
    transition: all 0.3s ease;
  }
  .favorite-btn {
  transition: transform .15s ease-in-out;
  }

  .favorite-btn:hover {
    transform: scale(1.1);
  }
</style>
