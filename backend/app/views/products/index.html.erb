<div class="m-3">
  <%= render 'shared/form_errors', object: @category %>
  <%= render 'shared/form_exited', object: @category %>
</div>

<div class="index-products p-4"> 
  <h1 class="text-uppercase fw-bold mb-5 mt-5"><%= @category.name %></h1>

  <% if @products.present? %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
      <% @products.each do |product| %>
        <div class="col mb-5 d-flex">
          <div class="h-100 w-100 d-flex flex-column">
            
            <% if product.stock > 0 %>
              <!-- Producto con stock -->
              <%= link_to category_product_path(product.category, product), class: "image-zoom-container d-block" do %>
                <% if product.image.attached? %>
                  <%= image_tag product.image, class: "card-img-top rounded-img", style: "height: 400px; object-fit: cover;" %>
                <% else %>
                  <%= image_tag "placeholder.svg", class: "card-img-top rounded-img", style: "height: 200px; object-fit: cover;" %>
                <% end %>
              <% end %>
            <% else %>
              <!-- Producto sin stock (imagen gris, no es link) -->
              <div class="image-zoom-container d-block">
                <% if product.image.attached? %>
                  <%= image_tag product.image, 
                        class: "card-img-top rounded-img out-of-stock-img", 
                        style: "height: 400px; object-fit: cover; filter: grayscale(100%); opacity: 0.6;" %>
                <% else %>
                  <%= image_tag "placeholder.svg", 
                        class: "card-img-top rounded-img out-of-stock-img", 
                        style: "height: 200px; object-fit: cover; filter: grayscale(100%); opacity: 0.6;" %>
                <% end %>
              </div>
            <% end %>

            <div class="card-body d-flex flex-column mt-auto">
              <div class="h-30 p-2">
                <h5 class="card-title text-uppercase fw-bold"><%= product.name %></h5>
              </div>

              <% if product.stock > 0 %>
                <!-- Formulario normal -->
                <%= form_with url: cart_items_path, method: :post, local: true, html: { class: "w-100 mt-auto" } do %>
                  <%= hidden_field_tag :product_id, product.id %>
                  <div class="mb-3">
                    <label class="form-label fw-bold">Talla</label>
                    <div class="d-flex flex-wrap gap-3 mt-2 justify-content-start">
                      <% product.sizes.each_with_index do |size, index| %>
                        <%= radio_button_tag "size", size, index == 0, id: "size_#{product.id}_#{size}", class: "btn-check" %>
                        <label class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold size-option" for="size_<%= product.id %>_<%= size %>">
                          <%= size %>
                        </label>
                      <% end %>
                    </div>
                  </div>
                  <p class="card-text fs-4 fw-bold color-green">$ <%= product.formatted_price %> </p>

                  <button type="submit" class="button w-100 mt-auto">
                    <%= t("add_to_cart") %>
                    <svg class="cartIcon" viewBox="0 0 576 512"><path d="..."></path></svg>
                  </button>
                <% end %>
              <% else %>
                <!-- Botón deshabilitado si no hay stock -->
                <p class="card-text fs-4 fw-bold text-danger">Agotado</p>
                <button class="button w-100 btn-disabled mt-auto" disabled style="background-color: #ccc; cursor: not-allowed;">
                  No disponible
                </button>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-danger">
      <%= t("no_products") %>
    </p>
  <% end %>
</div>
