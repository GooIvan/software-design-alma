<div class="m-3">
  <%= render 'shared/form_errors', object: @category %>
  <%= render 'shared/form_exited', object: @category %>
</div>

<div class="index-products p-4">
  <h1 class="text-uppercase fw-bold mb-5 mt-5"><%= @category.name %></h1>

  <% if @products.present? %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
      <% @products.each do |product| %>
        <div class="col mb-5">
          <div class="d-flex flex-column align-items-start h-100">

            <div class="w-100">
              <% if product.stock > 0 %>
                <%= link_to category_product_path(product.category, product), class: "image-zoom-container d-block position-relative #{'has-multiple-images' if product.images.count > 1}" do %>
                  <% if product.images.attached? && product.images.first.present? %>
                    <!-- Primera imagen (siempre visible) -->
                    <%= image_tag product.images.first,
                          class: "card-img-top rounded-img product-image-main",
                          style: "height: 400px; object-fit: cover; width: 100%; transition: opacity 0.3s ease;" %>
                    
                    <!-- Segunda imagen (visible en hover) -->
                    <% if product.images.count > 1 %>
                      <%= image_tag product.images.second,
                            class: "card-img-top rounded-img product-image-hover position-absolute",
                            style: "height: 400px; object-fit: cover; width: 100%; top: 0; left: 0; opacity: 0; transition: opacity 0.3s ease;" %>
                    <% end %>
                  <% else %>
                    <%= image_tag "placeholder.svg",
                          class: "card-img-top rounded-img",
                          style: "height: 200px; object-fit: cover; width: 100%;" %>
                  <% end %>
                <% end %>
              <% else %>
                <div class="image-zoom-container d-block position-relative">
                  <% if product.images.attached? && product.images.first.present? %>
                    <%= image_tag product.images.first,
                          class: "card-img-top rounded-img",
                          style: "height: 400px; object-fit: cover; width: 100%; opacity: 0.5; cursor: not-allowed;" %>
                  <% else %>
                    <%= image_tag "placeholder.svg",
                          class: "card-img-top rounded-img",
                          style: "height: 200px; object-fit: cover; width: 100%; opacity: 0.5; cursor: not-allowed;" %>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="content-container w-100 text-start mt-3">
              <h5 class="card-title text-uppercase fw-bold"><%= product.name %></h5>

              <% if product.stock > 0 %>
                <%= form_with url: cart_items_path, method: :post, local: true, html: { class: "mt-auto w-100" } do %>
                  <%= hidden_field_tag :product_id, product.id %>

                  <div class="mb-3">
                    <label class="form-label fw-bold"> <%= t('products.size') %> </label>
                    <div class="d-flex flex-wrap gap-3 mt-2 justify-content-start">
                      <% product.sizes.each_with_index do |size, index| %>
                        <%= radio_button_tag "size", size, index == 0, id: "size_#{product.id}_#{size}", class: "btn-check" %>
                        <label class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold size-option" for="size_<%= product.id %>_<%= size %>">
                          <%= size %>
                        </label>
                      <% end %>
                    </div>
                  </div>

                  <p class="card-text fs-4 fw-bold color-green">$ <%= product.formatted_price %></p>

                  <button type="submit" class="button w-100" style="width: 100%;">
                    <%= t("add_to_cart") %>
                    <svg class="cartIcon" viewBox="0 0 576 512"><path d="M0 24C0 10.7 10.7 0 24 0H69.5c22 0 41.5 12.8 50.6 32h411c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3H170.7l5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5H488c13.3 0 24 10.7 24 24s-10.7 24-24 24H199.7c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5H24C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"></path></svg>
                  </button>
                <% end %>
              <% else %>
                <div class="mb-3">
                  <label class="form-label fw-bold"> <%= t('products.size') %> </label>
                  <div class="d-flex flex-wrap gap-3 mt-2 justify-content-start">
                    <% product.sizes.each do |size| %>
                      <input type="radio" disabled class="btn-check">
                      <label class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold disabled text-muted" style="pointer-events: none; opacity: 0.6;">
                        <%= size %>
                      </label>
                    <% end %>
                  </div>
                </div>

                <p class="card-text fs-4 fw-bold text-muted" style="text-align: left;">$ <%= product.formatted_price %></p>

                <button class="btn btn-secondary w-100 fw-bold" style="pointer-events: none; border-radius: 20px; width: 100%;" disabled>
                  <%= t('products.sold_out') %>
                </button>
              <% end %>
            </div>

          </div>
        </div>

      <% end %>
    </div>
  <% else %>
    <p class="text-danger"><%= t("no_products") %></p>
  <% end %>

<style>
  /* Efecto hover para mostrar segunda imagen - solo cuando hay múltiples imágenes */
  .image-zoom-container.has-multiple-images:hover .product-image-hover {
    opacity: 1 !important;
  }
  
  .image-zoom-container.has-multiple-images:hover .product-image-main {
    opacity: 0 !important;
  }
</style>
</div>