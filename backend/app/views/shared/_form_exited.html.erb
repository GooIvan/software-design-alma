<!-- ALERTAS -->
<div id="flash-wrapper" class="position-fixed top-0 start-50 translate-middle-x mt-3" style="z-index: 11000;">
  <% if notice %>
    <div id="flash-notice" class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm px-3 py-2" role="alert">
      <%= notice %>
    </div>
  <% end %>

  <% if alert %>
    <div id="flash-alert" class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm px-3 py-2" role="alert">
      <%= alert %>
    </div>
  <% end %>
</div>


<%= javascript_tag do %>
  setTimeout(function() {
  const notice = document.getElementById('flash-notice');
    const alert = document.getElementById('flash-alert');
    if (notice) notice.style.display = 'none';
    if (alert) alert.style.display = 'none';
  }, 2000);
<% end %>