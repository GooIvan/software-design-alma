<!-- Sección de Beneficios -->
<div class="features-section py-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-3 col-6">
        <div class="feature-card text-center">
          <div class="feature-icon">
            <i class="bi bi-truck"></i>
          </div>
          <h5 class="feature-title"><%= t('features.free_shipping', default: 'Envío Gratis') %></h5>
          <p class="feature-desc"><%= t('features.free_shipping_desc', default: 'En compras mayores a $100.000') %></p>
        </div>
      </div>
      
      <div class="col-md-3 col-6">
        <div class="feature-card text-center">
          <div class="feature-icon">
            <i class="bi bi-shield-check"></i>
          </div>
          <h5 class="feature-title"><%= t('features.secure_payment', default: 'Pago Seguro') %></h5>
          <p class="feature-desc"><%= t('features.secure_payment_desc', default: '100% protegido') %></p>
        </div>
      </div>
      
      <div class="col-md-3 col-6">
        <div class="feature-card text-center">
          <div class="feature-icon">
            <i class="bi bi-arrow-repeat"></i>
          </div>
          <h5 class="feature-title"><%= t('features.easy_returns', default: 'Devoluciones Fáciles') %></h5>
          <p class="feature-desc"><%= t('features.easy_returns_desc', default: '30 días para devoluciones') %></p>
        </div>
      </div>
      
      <div class="col-md-3 col-6">
        <div class="feature-card text-center">
          <div class="feature-icon">
            <i class="bi bi-headset"></i>
          </div>
          <h5 class="feature-title"><%= t('features.support', default: 'Soporte 24/7') %></h5>
          <p class="feature-desc"><%= t('features.support_desc', default: 'Siempre listos para ayudarte') %></p>
        </div>
      </div>
    </div>
  </div>
</div>
