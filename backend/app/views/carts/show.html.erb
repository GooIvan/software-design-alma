<div class="container my-5">
  <h2 class="text-uppercase fw-bold mb-4" style="font-family: 'Helvetica Neue', sans-serif;">
  <%= t("cart").upcase %> (
  <span id="main_cart_count">
    <%= render partial: "shared/cart/cart_count", locals: { cart: @cart } %>
  </span>

  <%= t("items") %>)
  </h2>

  <% if @cart.cart_items.any? %>
    <%= turbo_frame_tag "cart_items_list" do %>
      <%= render partial: "cart_items/list", locals: { cart: @cart } %>
    <% end %>
  <% else %>
    <div class="alert alert-info">
      <%= t("empty_cart") %>
      <%= link_to t("shop_all"), categories_path(locale: I18n.locale), class: "btn btn-outline-dark ms-2" %>
    </div>
  <% end %>
</div>
