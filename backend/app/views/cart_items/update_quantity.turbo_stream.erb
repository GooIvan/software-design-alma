<% cart = current_cart %>
<% item = @cart_item %>
<% cart_count = cart.cart_items.sum(:quantity) %>

<% if item.destroyed? %>
  <%= turbo_stream.remove "line_item_#{item.id}" %>
  <%= turbo_stream.remove "side_cart_item_#{item.id}" %>
<% else %>
  <%= turbo_stream.replace "line_item_#{item.id}" do %>
    <%= render partial: "cart_items/line_item", locals: { item: item } %>
  <% end %>

  <%= turbo_stream.replace "side_cart_item_#{item.id}" do %>
    <%= render partial: "cart_items/cart_item", locals: { item: item } %>
  <% end %>
<% end %>

<%= turbo_stream.replace "main_cart_count", partial: "shared/cart/cart_count", locals: { cart: cart } %>
<%= turbo_stream.replace "side_cart_count", partial: "shared/cart/cart_count", locals: { cart: cart } %>


<%= turbo_stream.replace "total_price" do %>
  <% total_price = number_to_currency(cart.cart_items.sum { |i| i.product.price * i.quantity }, precision: 0) %>
  <div class="side-cart-footer p-3 border-top w-100 d-flex justify-content-between align-items-center">
    <%= link_to "#{t("checkout")} #{total_price}", categories_path(locale: I18n.locale), class: "cart-button ms-2" %>
  </div>
<% end %>

<%= turbo_stream.replace "cart_subtotal", partial: "cart_items/summary", locals: { cart: cart } %>

<%= turbo_stream.replace "cart_icon_xl", partial: "shared/cart/cart_icon", locals: {
      icon_id: "cart-toggle-xl",
      extra_classes: "d-none d-lg-flex",
      cart_items_count: cart_count
    } %>

<%= turbo_stream.replace "cart_icon_mobile", partial: "shared/cart/cart_icon", locals: {
      icon_id: "cart-toggle",
      extra_classes: "d-lg-none",
      cart_items_count: cart_count
    } %>

<% if cart.cart_items.empty? %>
  <%= turbo_stream.replace "side_cart_content", partial: "shared/cart/side_cart_empty_content" %>
  <%= turbo_stream.replace "total_price", partial: "shared/cart/side_cart_footer_empty" %>
<% end %>
